+  /* ---------- Support Service (below Our Services) ---------- */
+  .support{
+    background:var(--surface);
+    padding-top:56px;
+  }
+  html[data-theme="dark"] .support{background:color-mix(in srgb, var(--surface-2) 40%, transparent);}
